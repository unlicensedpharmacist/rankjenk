{
  "name": "rankjenk",
  "main": "worker.js",
  "compatibility_date": "2025-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rankjenk",
      "database_id": "34b27b97-e5a9-400c-b8da-d6a6d8bbb102"
    }
  ]
}
